{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "Angular",
      "matchManagers": ["npm"],
      "matchPackagePatterns": [
        "^@angular/",
        "^zone\\.js",
        "^@ngrx/",
        "^@ngtools/",
        "^@ng-easy/",
        "^@angular-devkit/",
        "^ng-packagr",
        "^tslib",
        "^@angular-eslint/",
        "^typescript$"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"]
    },
    {
      "groupName": "TypeScript",
      "matchManagers": ["npm"],
      "matchPackagePatterns": [
        "^@types/"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"]
    },
    {
      "groupName": "Vis",
      "matchManagers": ["npm"],
      "matchPackagePatterns": [
        "vis-data",
        "vis-network",
        "vis-timeline",
        "vis-util",
        "^uuid$",
        "^propagating-hammerjs$"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"]
    },
    {
      "groupName": "ESLint",
      "matchManagers": ["npm"],
      "matchPackagePatterns": [
        "^eslint",
        "^@eslint/",
        "^eslint-config-",
        "^eslint-plugin-"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"]
    },
    {
      "groupName": "Karma + Jasmine",
      "matchManagers": ["npm"],
      "matchPackagePatterns": [
        "^jasmine",
        "^@types/jasmine",
        "^karma",
        "^karma-"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"]
    },
    {
      "groupName": "Commitlint",
      "matchManagers": ["npm"],
      "matchPackagePatterns": [
        "^@commitlint/"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"]
    }
  ],
  "prHourlyLimit": 10
}
