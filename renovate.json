{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "groupName": "Angular",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "matchPackageNames": [
        "/^@angular//",
        "/^zone\\.js/",
        "/^@ngrx//",
        "/^@ngtools//",
        "/^@ng-easy//",
        "/^@angular-devkit//",
        "/^ng-packagr/",
        "/^tslib/",
        "/^@angular-eslint//",
        "/^typescript$/"
      ]
    },
    {
      "groupName": "TypeScript",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "matchPackageNames": [
        "/^@types//"
      ]
    },
    {
      "groupName": "Vis",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "matchPackageNames": [
        "/vis-data/",
        "/vis-network/",
        "/vis-timeline/",
        "/vis-util/",
        "/^uuid$/",
        "/^propagating-hammerjs$/"
      ]
    },
    {
      "groupName": "ESLint",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "matchPackageNames": [
        "/^eslint/",
        "/^@eslint//",
        "/^eslint-config-/",
        "/^eslint-plugin-/"
      ]
    },
    {
      "groupName": "Karma + Jasmine",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "matchPackageNames": [
        "/^jasmine/",
        "/^@types/jasmine/",
        "/^karma/",
        "/^karma-/"
      ]
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["jasmine-core", "@types/jasmine"],
      "allowedVersions": "<5.0.0",
      "description": "karma-jasmine@5.x requires jasmine-core ^4.1.0; upgrading past 4.x causes duplicate Jasmine instances and a read-only globals error"
    },
    {
      "groupName": "Commitlint",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "matchPackageNames": [
        "/^@commitlint//"
      ]
    }
  ],
  "prHourlyLimit": 10
}
