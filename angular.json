{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "ngx-vis": {
      "projectType": "library",
      "root": "",
      "sourceRoot": "",
      "architect": {
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "include": [
              "components/**/*.spec.ts"
            ],
            "codeCoverage": true
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
